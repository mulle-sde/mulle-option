### << END OF mulle-boot.sh <<

#
# Versioning of this script
#
MULLE_EXECUTABLE_VERSION="0.1.0"


### >> START OF mulle-bashfunctions-minimal-embed.sh >>
### << END OF mulle-bashfunctions-minimal-embed.sh <<

print_flags()
{
   cat <<EOF
   --final-title <s>      : set string for final result output ("" to suppress)
   --no-ctrl-c            : do not trap CTRL-C, this disables polling
   --no-search            : disable search functionality when typing characters
   --option <s>           : you can also add options by an option string
   --options <s>          : as option, pass multiple options separated by '\\n'
   --cursor-prefix <c>    : set prefix for the current line ("> ")
   --no-cursor-prefix <c> : set prefix for non-current lines ("  ")
   --selected-prefix <c>  : set prefix for selected options ("[x] ")
   --unselected-prefix <c>: set prefix for unselected options ("[ ] ")
   --select <mask>        : pre-select options by a bitmask (decimal)
   --sv-rc                : trust tput sv/rc, which seems to be broken often
   --timeout <n>          : auto-select after n seconds (selects current mask)
   --title <s>            : set string for initial prompt ("" to suppress)
   --visible-items <n>    : number of items to present at once (7)
EOF

   options_technical_flags_usage \
                "                  : "
}


usage()
{
   [ $# -ne 0 ] && log_error "$*"


   cat <<EOF >&2
   Usage:
   mulle-option [flags] <option> ...

   Present a multi-select menu on the command line. The user can navigate
   with cursor keys (or SHIFT-'J' / SHIFT-'K'), toggle options with SPACE,
   select all with 'a', clear all with 'c', confirm with ENTER, and quit
   with ESC (or 'q').

   Options can specify a mask value with <name>=<value> syntax (e.g.
   name=0x100 for bit 8). Values not specified are implicit: if the previous
   option has explicit value P, the next implicit value is (P << 1);
   otherwise bits are sequential (1, 2, 4, 8...).

   The result is the combined bitmask printed as hex (e.g. 0x5). Up to 64
   options (fits in a 64-bit mask).

   Exit codes:
    0      : user confirmed a selection (bitmask on stdout)
    128    : user opted out
    130    : user pressed CTRL-C
    131    : options are empty
    132    : too many options (64 max)
    141    : EOF encountered

Flags:
EOF
   print_flags | LC_ALL=C sort >&2

   if [ -z "${MULLE_TRACE}" ]
   then
   cat <<EOF >&2
      (use -v flag to see more options)
EOF
   fi
   echo "" >&2

   exit 133
}


#
# Render the visible portion of the option list
#
_r_option_draw_menu()
{
   local cur="$1"
   local max_visi_items="$2"
   local cursor_prefix="$3"
   local no_cursor_prefix="$4"
   local selected_prefix="$5"
   local unselected_prefix="$6"
   local mask="$7"

   if [ ${ZSH_VERSION+x} ]
   then
      setopt local_options KSH_ARRAYS
   fi

   local term_width
   local term_height

   term_width=$(tput cols)
   term_height=$(tput lines)

   local max_items

   max_items=$(($term_height - 1))
   if (( max_items > max_visi_items ))
   then
      max_items=${max_visi_items}
   fi
   if (( max_items > ${#__option_names[@]} ))
   then
      max_items=${#__option_names[@]}
   fi

   local max_width

   max_width=$(( ${term_width} - ${#cursor_prefix} - ${#selected_prefix} ))
   if (( max_width < 4 ))
   then
      max_width=4
   fi

   local half_window
   half_window=$((max_items / 2))

   local start
   local end

   start=$((cur - half_window))
   end=$((cur + half_window))

   if ((start < 0))
   then
       start=0
       end=$((max_items - 1))
   else
      if ((end >= ${#__option_names[@]}))
      then
         end=$(( ${#__option_names[@]} - 1 ))
         start=$((end - max_items + 1))
      fi
   fi

   local i
   local n
   local item
   local value
   local selprefix
   local curprefix

   n=0
   for ((i=start; i<=end; i++))
   do
      item="${__option_names[$i]}"
      value="${__option_values[$i]}"
      if (( (mask & value) != 0 ))
      then
         selprefix="${selected_prefix}"
      else
         selprefix="${unselected_prefix}"
      fi

      if [[ $i -eq $cur ]]
      then
         curprefix="${cursor_prefix}"
      else
         curprefix="${no_cursor_prefix}"
      fi

      printf "${curprefix}${selprefix}%.*s${C_RESET}\n" "${max_width}" "${item}"
      n=$(( n + 1 ))
   done

   RVAL=$n
}


_option_clear_menu()
{
   local n="$1"

   while [ $n -gt 0 ]
   do
      tput cuu1
      n=$(( n - 1 ))
   done
   tput ed
}


_option_ctrl_c()
{
   _option_ctrl_c_pressed='YES'
   tput sgr0
   tput rmacs
}


option_selection_loop()
(
   log_entry "option_selection_loop" "$@"

   local max_visi_items="$1"
   local cur="$2"
   local mask="$3"
   local cursor_prefix="$4"
   local no_cursor_prefix="$5"
   local selected_prefix="$6"
   local unselected_prefix="$7"
   local mode="$8"
   local options="$9"
   local user_timeout="${10}"
   local maskfile="${11}"

   local __option_names=()
   local __option_values=()
   local option
   local name

   .foreachline option in ${options}
   .do
      name="${option%%=*}"
      __option_names+=("$name")
      __option_values+=(${option#*=})
   .done

   case ",${mode}," in
      *,sv-rc,*)
         tput sc
      ;;
   esac

   tput sgr0
   tput rmacs
   tput civis

   if [ "$cur" -ge "${#__option_names[@]}" ] 2> /dev/null
   then
      cur=0
   fi

   local n
   _r_option_draw_menu "${cur}" "${max_visi_items}" "${cursor_prefix}" "${no_cursor_prefix}" "${selected_prefix}" "${unselected_prefix}" "${mask}"
   n="${RVAL}"

   _option_ctrl_c_pressed='NO'

   local timeout_limit=0
   local timeout_counter=0

   if [ ! -z "${user_timeout}" ]
   then
      timeout_limit=$((user_timeout * 4))
   fi

   case ",${mode}," in
      *,no-ctrl-c,*)
         timeout=
      ;;
      *)
         timeout="-t 0.2500"
         trap _option_ctrl_c SIGINT
      ;;
   esac

   local key
   local rc=-128
   local readflags
   local bit

   if [ ${ZSH_VERSION+x} ]
   then
      readflags="-k1"
      stty -echo
   else
      readflags="-s -N1"
   fi

   while [ $rc -eq -128 ]
   do
      while read ${readflags} ${timeout} key
      do
          if [[ "$key" == "" ]]
          then
             rc=141
             continue
          fi

          if [ "${key}" = $'\e' ]
          then
             read ${readflags} -t 0.0001 k1
             read ${readflags} -t 0.0001 k2
             read ${readflags} -t 0.0001 k3
             key="${key}${k1}${k2}${k3}"
          fi

          log_debug "key: ${key}"

          case "$key" in
              J|$'\e[A'|$'\e0A'|$'\e[D'|$'\e0D')
                 ((cur > 0)) && ((cur--))
              ;;

              K|$'\e[B'|$'\e0B'|$'\e[C'|$'\e0C')
                  ((cur < ${#__option_names[@]}-1)) && ((cur++))
              ;;

               ' ')
                  value="${__option_values[$cur]}"
                  mask=$((mask ^ value))
               ;;

              a|A)
                  local __abi
                  mask=0
                  for ((__abi=0; __abi < ${#__option_values[@]}; __abi++))
                  do
                     value="${__option_values[$__abi]}"
                     mask=$((mask | value))
                  done
               ;;

              c|C)
                 mask=0
              ;;

              $'\n')
                 rc=0
                 break
              ;;

              q|Q|$'\e')
                 rc=128
                 break
              ;;

              [a-zA-Z0-9\!\@\#\$\%\^\&\*\(\)\_\+\-\=\[\]\{\}\;\'\,\.\/\:\"\\])
                 case ",${mode}," in
                    *,no-search,*)
                     ;;
                    *)
                      _find_option_by_char "$key" "$cur" "NO"
                      cur=$RVAL
                     ;;
                 esac
              ;;
          esac

           _option_clear_menu "${n}"
           _r_option_draw_menu "${cur}" "${max_visi_items}" "${cursor_prefix}" "${no_cursor_prefix}" "${selected_prefix}" "${unselected_prefix}" "${mask}"
           n="${RVAL}"
      done

      if [ ! -z "${user_timeout}" ] && [ ${timeout_limit} -gt 0 ]
      then
         timeout_counter=$((timeout_counter + 1))
         if [ ${timeout_counter} -ge ${timeout_limit} ]
         then
            rc=0
            break
         fi
      fi

      if [ "${_option_ctrl_c_pressed}" = 'YES' ]
      then
         rc=130
      fi
   done

   if [ ${ZSH_VERSION+x} ]
   then
      stty 'echo'
   fi

   _option_clear_menu "${n}"

   case ",${mode}," in
      *,sv-rc,*)
         tput 'rc'
         tput 'ed'
      ;;
   esac

   tput 'cnorm'
   tput 'rmacs'

   printf "%s\n" "${mask}" > "${maskfile}"

   if [ $rc -ne 0 ]
   then
      return $rc
   fi

   return 0
)


_find_option_by_char()
{
   local search_char="$1"
   local current_pos="$2"
   local case_sensitive="${3:-NO}"

   if [ ${ZSH_VERSION+x} ]
   then
      setopt local_options KSH_ARRAYS
   fi

   local i
   local item
   local first_char
   local exact_match=-1
   local next_index=-1

   if [ "${case_sensitive}" = "NO" ]
   then
      search_char=$(echo "$search_char" | tr '[:upper:]' '[:lower:]')
   fi

   for ((i=0; i<${#__option_names[@]}; i++))
   do
      item="${__option_names[$i]}"
      first_char="${item:0:1}"

      if [ "${case_sensitive}" = "NO" ]
      then
         first_char=$(echo "$first_char" | tr '[:upper:]' '[:lower:]')
      fi

      if [ "$first_char" = "$search_char" ]
      then
         exact_match=$i
         break
      elif [ "$first_char" \> "$search_char" ] && [ $next_index -eq -1 ]
      then
         next_index=$i
      fi
   done

   if [ $exact_match -ne -1 ]
   then
      RVAL=$exact_match
   elif [ $next_index -ne -1 ]
   then
      RVAL=$next_index
   else
      RVAL=$current_pos
   fi
}


main()
{
   local OPTION_TITLE='DEFAULT'
   local OPTION_FINAL_TITLE='DEFAULT'
   local OPTION_VISIBLE_ITEMS=7
   local OPTION_CURSOR_PREFIX="> "
   local OPTION_NO_CURSOR_PREFIX="  "
   local OPTION_SELECTED_PREFIX="${C_GREEN}[x]${C_RESET} "
   local OPTION_UNSELECTED_PREFIX="[ ] "
   local OPTION_MASK=0
   local OPTION_MODE=
   local OPTION_TIMEOUT=
   local OPTIONS=
   local OPTIONS_RAW=

   while [ $# -ne 0 ]
   do
      if options_technical_flags "$1"
      then
         shift
         continue
      fi

      case "$1" in
         -f|--force)
            MULLE_FLAG_MAGNUM_FORCE='YES'
         ;;

         -h*|--help|help)
            usage
         ;;

         --title)
            [ $# -eq 1 ] && usage "missing argument to $1"
            shift

            OPTION_TITLE="$1"
         ;;

         --final-title)
            [ $# -eq 1 ] && usage "missing argument to $1"
            shift

            OPTION_FINAL_TITLE="$1"
         ;;

         --select)
            [ $# -eq 1 ] && usage "missing argument to $1"
            shift

            OPTION_MASK="$1"
         ;;

          --selected-prefix)
             [ $# -eq 1 ] && usage "missing argument to $1"
             shift

             OPTION_SELECTED_PREFIX="$1"
          ;;

          --cursor-prefix)
             [ $# -eq 1 ] && usage "missing argument to $1"
             shift

             OPTION_CURSOR_PREFIX="$1"
          ;;

          --no-cursor-prefix)
             [ $# -eq 1 ] && usage "missing argument to $1"
             shift

             OPTION_NO_CURSOR_PREFIX="$1"
          ;;

          --unselected-prefix)
            [ $# -eq 1 ] && usage "missing argument to $1"
            shift

            OPTION_UNSELECTED_PREFIX="$1"
         ;;

          --option)
             [ $# -eq 1 ] && usage "missing argument to $1"
             shift

             if [ -z "$1" ]
             then
                continue
             fi

             r_add_line "${OPTIONS_RAW}" "$1"
             OPTIONS_RAW="${RVAL}"
          ;;

          --options)
             [ $# -eq 1 ] && usage "missing argument to $1"
             shift

             if [ -z "$1" ]
             then
                continue
             fi

             r_add_line "${OPTIONS_RAW}" "$1"
             OPTIONS_RAW="${RVAL}"
          ;;

         -n|--visible-items)
            [ $# -eq 1 ] && usage "missing argument to $1"
            shift

            OPTION_VISIBLE_ITEMS="$1"
         ;;

         --no-ctrl-c|--sv-rc|--no-search)
            r_comma_concat "${OPTION_MODE}" "${1:2}"
            OPTION_MODE="${RVAL}"
         ;;

         --timeout)
            [ $# -eq 1 ] && usage "missing argument to $1"
            shift

            OPTION_TIMEOUT="$1"
         ;;

         --version)
            printf "%s\n" "${MULLE_EXECUTABLE_VERSION}"
            exit 0
         ;;

         --)
            shift
            break
         ;;

         -*)
            usage "Unknown flag \"$1\""
         ;;

         *)
            break
         ;;
      esac

      shift
   done

   options_setup_trace "${MULLE_TRACE:-}" && set -x

   trap 'logging_reset ; exit 130' TERM INT

   local option
   local name
   local bitvalue
   local last_explicit_mask=-1
   local next_sequential=0

   for option in "$@"
   do
      if [ -z "${option}" ]
      then
         continue
      fi

      r_add_line "${OPTIONS_RAW}" "${option}"
      OPTIONS_RAW="${RVAL}"
   done

   .foreachline option in ${OPTIONS_RAW}
   .do
      if [[ "$option" == *=* ]]
      then
         name="${option%%=*}"
         maskvalue=$(( ${option#*=} ))
         last_explicit_mask="${maskvalue}"
      else
         name="$option"
         if [ "${last_explicit_mask}" -ge 0 ]
         then
            maskvalue=$((last_explicit_mask << 1))
            last_explicit_mask="${maskvalue}"
         else
            maskvalue=$((1 << next_sequential))
            next_sequential=$((next_sequential + 1))
         fi
      fi

      if (( maskvalue <= 0 && maskvalue != -9223372036854775808 ))
      then
         fail "Mask value ${maskvalue} for '${name}' must be positive (or 2^63)"
      fi

      r_add_line "${OPTIONS}" "${name}=${maskvalue}"
      OPTIONS="${RVAL}"
   .done

   r_count_lines "${OPTIONS}"
   count="${RVAL}"

   if [ "${count}" -gt 64 ]
   then
      log_warning "Too many options (max 64)"
      return 132
   fi

   if [ "${count}" -eq 0 ]
   then
      log_warning "Empty option list"
      return 131
   fi

   local title

   if ! [ -z "${OPTION_TITLE}" ]
   then
      title=${OPTION_TITLE}
      if [ "${OPTION_TITLE}" = 'DEFAULT' ]
      then
         title="Select options (SPACE=toggle, ENTER=done, a=all, c=none):"
      fi
   fi

   # Save original stdout for hex result, redirect rendering to /dev/tty
   exec 4>&1 1>/dev/tty

   if ! [ -z "${title}" ]
   then
      printf "%b\n" "${title}"
   fi

   local cur=0
   local tmpfile

   r_make_tmp
   tmpfile="${RVAL}"

   option_selection_loop "${OPTION_VISIBLE_ITEMS:-7}" \
                         "${cur}" \
                         "${OPTION_MASK}" \
                         "${OPTION_CURSOR_PREFIX}" \
                         "${OPTION_NO_CURSOR_PREFIX}" \
                         "${OPTION_SELECTED_PREFIX}" \
                         "${OPTION_UNSELECTED_PREFIX}" \
                         "${OPTION_MODE}" \
                         "${OPTIONS}" \
                         "${OPTION_TIMEOUT}" \
                         "${tmpfile}"
   rc=$?

   if [ -f "${tmpfile}" ]
   then
      mask="$(cat "${tmpfile}")"
      remove_file_if_present "${tmpfile}"
   else
      mask=0
   fi

   if [ $rc -eq 0 ]
   then
      if [ ! -z "${OPTION_TITLE}" ]
      then
         tput cuu1
         tput ed
      fi

      if [ ! -z "${OPTION_FINAL_TITLE}" ]
      then
         title="${OPTION_FINAL_TITLE}"
         if [ "${title}" = 'DEFAULT' ]
         then
            title="Your selection: "
         fi

         printf "%b" "${title}"

         local bit
         local first=YES
         local i=0
         local item

         .foreachline item in ${OPTIONS}
         .do
            value="${item#*=}"
            item="${item%%=*}"
            if (( (mask & value) != 0 ))
            then
               if [ "${first}" = 'YES' ]
               then
                  first=NO
               else
                  printf ", "
               fi
               printf "%s" "${item}"
            fi
            i=$((i + 1))
         .done

         printf "\n"
      fi

      printf "0x%llx\n" "${mask}" >&4
   fi

   return $rc
}


call_with_flags "main" "$@"
